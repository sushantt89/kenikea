# Copy this file to .env and fill in your own values.

# MongoDB connection string.
# Local MongoDB:       mongodb://127.0.0.1:27017/worker_assignment
# MongoDB Atlas (free): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/worker_assignment
MONGO_URI=mongodb://127.0.0.1:27017/worker_assignment

# Port the API server listens on
PORT=5000

# Origin the frontend runs on, for CORS (Vite default shown)
CLIENT_ORIGIN=http://localhost:5173

# Maximum number of active (unfinished) jobs a worker can hold at once
# before the assignment engine treats them as "at capacity".
MAX_CONCURRENT_JOBS=2

# --- Login (required) ---
# Secret used to sign login session tokens (see server/src/services/auth.js)
# - required, and the server refuses to start without it. Generate a random
# one (don't reuse this example, and don't reuse it across separate
# deployments of this app):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this later invalidates every existing login session (everyone
# gets logged out and has to log back in) - that's normal, not a bug.
AUTH_SECRET=

# On first run, if no user accounts exist yet, one is created automatically
# so there's a way to log in at all (see README > Login & user accounts -
# there's no public sign-up page, only an already-logged-in user can add
# more accounts, from Settings). These two are optional: leave them blank
# and a default email (admin@example.com) and a random password are used
# instead, with the generated password printed to the server console once
# at startup - copy it from there if you don't set ADMIN_PASSWORD yourself.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Fallback timezone, used only when a job's work area can't be determined
# yet (not guessed from its scraped address, not set by hand). Normally
# each job's scheduled time is handled in its OWN work area's real
# timezone (Adelaide/Perth/Brisbane/NSW/Auckland each map to their real
# IANA zone) regardless of this setting - see README > Timezones.
TZ=Australia/Adelaide

# --- Google Calendar (optional) ---
# When these three are set, assigning a job creates a Calendar event with
# the worker invited as an attendee. Leave them blank to skip Calendar
# integration entirely - the rest of the app works fine without it.
# See README > Google Calendar setup, or run `npm run get-google-token`
# after setting the first two, to obtain the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to create events on - "primary" is the signed-in account's
# main calendar. Use a specific calendar's ID to keep job events separate.
GOOGLE_CALENDAR_ID=primary

# --- Worker availability sync (optional) ---
# Pulls the team's fortnightly "Bi-weekly Schedule Update" Google Form
# responses into each worker's record (Workers tab > "Sync fortnight
# availability" button) - purely informational, does not affect assignment.
# Reuses GOOGLE_CLIENT_ID/SECRET/REFRESH_TOKEN above, but the refresh token
# must also carry the Sheets read-only scope - see README > Worker
# availability sync for how to (re)generate it with both scopes at once.
# Leave GOOGLE_AVAILABILITY_SHEET_ID blank to skip this feature entirely.
#
# The Sheet ID is the long ID in the linked "Form Responses" spreadsheet's
# URL: docs.google.com/spreadsheets/d/<THIS PART>/edit - open it from the
# form's Responses tab via the green sheet icon.
GOOGLE_AVAILABILITY_SHEET_ID=
# Which tab/range to read - the default matches what Google Forms names it
# automatically; only change this if you renamed that tab.
GOOGLE_AVAILABILITY_SHEET_RANGE=Form Responses 1

# --- Geocoding (optional but recommended) ---
# Worker/job locations are automatically converted from plain addresses
# into coordinates (so the assignment engine can use real distance instead
# of just matching location text) using the free OpenStreetMap Nominatim
# service - no API key needed. Their usage policy asks that requests
# identify the app with contact info; set this to your own email or app
# name. Leave the default and geocoding still works, it just identifies
# less usefully if OpenStreetMap ever needs to reach out.
GEOCODE_CONTACT=you@example.com

# Optional fallback geocoder. Nominatim (above) is tried first; if it fails
# (including the 403 Forbidden it returns when it decides an IP has made too
# many requests - this happens more than you'd expect on shared/office
# networks, and can lock you out for ~20-24 hours) and this key is set, the
# app automatically retries the same address via LocationIQ instead, which is
# far less prone to that. Free tier, no credit card: sign up at
# https://locationiq.com, create a key, paste it here. Leave blank to rely on
# Nominatim only (and the text-matching fallback if that fails too).
LOCATIONIQ_API_KEY=
